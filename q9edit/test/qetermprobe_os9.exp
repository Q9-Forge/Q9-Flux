#!/usr/bin/expect -f

set timeout 90
set send_slow {1 .01}

set q9_root /Volumes/SSD1TB/projects/Q9
set rom /Volumes/SSD1TB/projects/MWOS/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/ROMBUG/romimage.dev.running.BIN
set image $q9_root/local_images/OS9SYS.q9edit-dev.hda
set logfile $q9_root/q9edit/test/qetermprobe_os9_result.txt

log_file -noappend $logfile
spawn $q9_root/build/native/q9.exe --cb030 $rom --cf $image --net nat

proc stop_emulator {} {
    send "\x1d"
    expect eof
}

expect "devices online"
set timeout 25
set logged_in 0
for {set i 0} {$i < 10 && !$logged_in} {incr i} {
    expect {
        "User name?:" { sleep 1; send -s "super\r"; exp_continue }
        -re {Password[^\r\n]*:} { sleep 1; send -s "Al35uUbC\r"; exp_continue }
        -re {\$ ?$} { set logged_in 1 }
        timeout { send "\r" }
    }
}

if {!$logged_in} {
    send_log "\n<<<QETERMPROBE LOGIN FAILED>>>\n"
    stop_emulator
    exit 1
}

send -s "setenv TERM q9\r"
expect -re {\$ ?$}
send -s "qetermprobe\r"
expect {
    "qetermprobe: 80 columns, 24 lines" {}
    timeout {
        send_log "\n<<<QETERMPROBE SIZE FAILED>>>\n"
        stop_emulator
        exit 1
    }
}
expect {
    "qetermprobe: raw mode enabled" {}
    timeout {
        send_log "\n<<<QETERMPROBE RAW FAILED>>>\n"
        stop_emulator
        exit 1
    }
}
expect {
    "qetermprobe: terminal restored" {}
    timeout {
        send_log "\n<<<QETERMPROBE RESTORE FAILED>>>\n"
        stop_emulator
        exit 1
    }
}
expect -re {\$ ?$}
send -s "echo after-raw\r"
expect {
    "after-raw" {}
    timeout {
        send_log "\n<<<QETERMPROBE ECHO FAILED>>>\n"
        stop_emulator
        exit 1
    }
}
expect -re {\$ ?$}
send_log "\n<<<QETERMPROBE OS9 PASS>>>\n"
stop_emulator
