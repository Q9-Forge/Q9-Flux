#!/usr/bin/expect -f

set timeout 90
set q9_root /Volumes/SSD1TB/projects/Q9
set rom /Volumes/SSD1TB/projects/MWOS/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/ROMBUG/romimage.dev.running.BIN
set image $q9_root/local_images/OS9SYS.q9edit-dev.hda
set logfile $q9_root/q9edit/test/qe_x1_result.txt

log_file -noappend $logfile
spawn $q9_root/build/native/q9.exe --cb030 $rom --cf $image --net nat
set emulator_spawn $spawn_id
expect "devices online"
expect -re {1 devices online}
sleep 2

spawn python3 $q9_root/q9edit/test/x1_key_client.py --editor
set timeout 30
expect {
    "qe x1 launch: PASS" {}
    eof {
        send_log "\n<<<QE X1 ENDED EARLY>>>\n"
        set spawn_id $emulator_spawn
        send "\x1d"
        expect eof
        exit 1
    }
    timeout {
        send_log "\n<<<QE X1 TIMEOUT>>>\n"
        close
        wait
        set spawn_id $emulator_spawn
        send "\x1d"
        expect eof
        exit 1
    }
}
catch {expect eof}
send_log "\n<<<QE X1 PASS>>>\n"
set spawn_id $emulator_spawn
send "\x1d"
expect eof
