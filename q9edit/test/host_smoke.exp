#!/usr/bin/expect -f

set timeout 5
set root [file normalize [file join [file dirname [info script]] ..]]
set editor [file join $root build host qe]
set sample /tmp/q9edit-host-smoke.c

set file_handle [open $sample w]
puts $file_handle "int main(void) { return 0; }"
close $file_handle

spawn /bin/sh -c "stty rows 24 columns 80; exec $editor $sample"
set screen_detected 0
expect {
    -re {\x1b\[6n} {
        send "\033\[24;80R"
        exp_continue
    }
    -re {HELP: Ctrl-S = save.*Ctrl-Q = quit} {
        set screen_detected 1
    }
    timeout {
        send_user "q9edit host smoke: editor screen not detected\n"
        exit 1
    }
}

if {!$screen_detected} {
    send_user "q9edit host smoke: editor screen not detected\n"
    exit 1
}

send "\021"
expect eof
file delete -force $sample
send_user "q9edit host smoke: PASS\n"
