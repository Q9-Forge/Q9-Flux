; Q9 Flux – Hawk-Debugprofil über macOS vmnet Shared Mode
; Zieladresse für OS-9/Hawk: 192.168.200.2

[board]
name = Q9 Emu (Hawk vmnet)
rom  = local_images/roms/romimage.dev.running.BIN
net  = vmnet
vmnet_ip       = 192.168.200.2
vmnet_gateway  = 192.168.200.1
vmnet_netmask  = 255.255.0.0
vmnet_dhcp_end = 192.168.200.254

[c0]
type = rbf
bus = onboard
unit = master
base = 0xFFFFE000
start_sector = 0
length_sectors = 0x800000
descriptor_lsn = 0
descriptor = yes
descriptor_name = local_images/c0
image = local_images/OS9SYS.hda

[d0]
type = rbf
bus = secondary
unit = master
base = 0xFFFFE100
start_sector = 0
length_sectors = 0x6183c
descriptor_lsn = 0
descriptor = yes
descriptor_name = local_images/d0
image = local_images/hd1.hda

[e0]
type = rbf
bus = secondary
unit = master
base = 0xFFFFE200
start_sector = 0
length_sectors = 0x800000
descriptor_lsn = 0
descriptor = yes
descriptor_name = local_images/e0
image = local_images/hd2.hda
