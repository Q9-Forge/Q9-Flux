; Q9 reales CF-Testprofil 5.19b

[board]
name = CB030-Q9 real CF profile
rom  = ../MWOS/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/ROMBUG/romimage.dev.running.BIN
net  = nat

[c0]
type = rbf
bus = onboard
unit = master
base = 0xFFFFE000
start_sector = 0
length_sectors = 0x800000
descriptor_lsn = 0
descriptor = local_images/c0
image = local_images/OS9SYS.cf_profile_test.hda

[d0]
type = pcf
bus = secondary
unit = master
base = 0xFFFFE100
start_sector = 0
length_sectors = 0x3FF800
descriptor_lsn = 64
descriptor = local_images/d0
image = local_images/q9-d0-pcf-2gb.img

[e0]
type = pcf
bus = secondary
unit = master
base = 0xFFFFE200
start_sector = 0
length_sectors = 0x200000
descriptor_lsn = 64
descriptor = local_images/e0-pcf
image = local_images/q9-e-shared-2gb.img

[e1]
type = rbf
bus = secondary
unit = master
base = 0xFFFFE200
start_sector = 0
length_sectors = 0x1FFFC0
descriptor_lsn = 0x200040
descriptor = local_images/e1
image = local_images/q9-e-shared-2gb.img
