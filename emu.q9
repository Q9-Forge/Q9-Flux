; Q9 reales CF-Profil (5.19b) — Standard-Arbeitskonfiguration
; c0: Boot-RBF bei Sektor 0
; d0: eigenes RBF-Whole-Disk-Image (hd1.hda), kein MBR/FAT, Descriptor ab Sektor 0
; e0: eigenes RBF-Whole-Disk-Image (hd2.hda), kein MBR/FAT, Descriptor ab Sektor 0
; Die Descriptor-Dateien werden vom ROM/Bootfile-Generator verwendet.

[board]
name = Q9 Emu
rom  = .q9-flux/romimage.dev.running.BIN
net  = slirp
; slirp = libslirp (plattformuebergreifend, kein root/keine extra Netzwerkschnittstelle noetig),
; Subnetz ueber dieselben vmnet_*-Keys wie das vmnet-Backend (wiederverwendet). Kernfunktion
; (OS-9 -> Internet) verifiziert stabil; Port-Weiterleitung (net_hostfwd) war wegen eines
; eigenen Konfigfehlers (cfg.version, s. Q9_VENDOR.md/slirp_net.c 1.03) deaktiviert -- jetzt behoben.
vmnet_ip       = 192.168.200.2
vmnet_gateway  = 192.168.200.1
vmnet_netmask  = 255.255.255.0
vmnet_dhcp_end = 192.168.200.254
net_hostfwd    = tcp:2323:23   ; Host-Port 2323 -> Gast-telnetd auf Port 23

; nat = eingebautes Mini-NAT (kein root, keine extra Netzwerkschnittstelle noetig), Gegenstelle
; fest auf 192.168.200.1 (Host) / 192.168.200.2 (Gast) verdrahtet -- keine weiteren Keys dafuer.
; net = nat

; vmnet (nur macOS, braucht vmnet.framework) fuer den Mac-Test wieder aktivieren:
; net = vmnet

[c0]
type = rbf
bus = onboard
unit = master
base = 0xFFFFE000
start_sector = 0
length_sectors = 0x800000
descriptor_lsn = 0
descriptor = .q9-flux/c0
image = .q9-flux/OS9SYS.hda

