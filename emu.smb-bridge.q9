; SMB-Test ueber echtes LAN (bridge:en8) gegen NAS8 192.168.70.10

[board]
name = Q9 SMB Bridge Test
rom  = local_images/roms/romimage.dev.running.BIN
net  = bridge:en8
vmnet_ip       = 192.168.200.2
vmnet_gateway  = 192.168.200.1
vmnet_netmask  = 255.255.255.0
vmnet_dhcp_end = 192.168.200.254

[c0]
type = rbf
bus = onboard
unit = master
base = 0xFFFFE000
start_sector = 0
length_sectors = 0x800000
descriptor_lsn = 0
descriptor = local_images/c0
image = local_images/OS9SYS.hda.smb209-test.hda
