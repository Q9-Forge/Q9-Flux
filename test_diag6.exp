#!/usr/bin/expect -f
# Laesst den DIAGNOSE-Build des selbstgebauten Compilers den Bootstrap-
# Quelltext uebersetzen. Anders als der normale Build hat dieser ein echtes,
# ungepuffertes stderr (-> /dd/qcc_diag.txt), kann also sagen, WAS er
# beanstandet, statt nur SEMERR zu melden.
#
# Nur Prompt-Matches, keine Regex auf Schlusswoerter: dieses OS-9 beendet
# Zeilen mit blankem \n. Alle Ergebnisse werden am Host aus den Dateien
# geprueft.
log_file -a /tmp/diagrun.log
set timeout 2400
set send_slow {1 .003}
set image local_images/OS9SYS.qcc-xcc-test.hda
set mwos /Volumes/SSD1TB/projects/MWOS
set module /dd/CMDS/q9_qcc_diag
set prompt {[#$] ?$}

spawn ./build/macos/q9.exe --rom $mwos/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/ROMBUG/romimage.dev.running.BIN --cf $image
expect "devices online"
send "\r"
set logged_in 0
for {set i 0} {$i < 10 && !$logged_in} {incr i} {
    expect {
        "User name?:" { send "super\r"; exp_continue }
        -re {Password[^\r\n]*:} { send "Al35uUbC\r"; exp_continue }
        -re $prompt { set logged_in 1 }
        timeout { send "\r" }
    }
}
if {!$logged_in} { send_log "\nDIAG: LOGIN FAILED\n"; exit 1 }

proc run {cmd label} {
    global prompt
    set t0 [clock seconds]
    send_log "\nDIAG: $label -- start\n"
    send -s "$cmd\r"
    expect {
        -re $prompt          { send_log "\nDIAG: $label -- Prompt nach [expr {[clock seconds]-$t0}] s\n" }
        -re {Stack Overflow} { send_log "\nDIAG: $label -- STACK OVERFLOW\n"; exit 1 }
        -re {PMMU}           { send_log "\nDIAG: $label -- PMMU\n"; exit 1 }
        timeout              { send_log "\nDIAG: $label -- TIMEOUT\n"; exit 1 }
    }
}

# Rauchprobe zuerst -- sie muss eine LEERE Diagnosedatei hinterlassen.
run "del /dd/qcc_diag.txt" "alte Diagnosedatei weg"
run "$module @/dd/bootstrap_probe.c >/dd/diag_probe.ir" "Rauchprobe"
run "dir -e /dd/qcc_diag.txt" "Diagnosedatei nach Rauchprobe"

# Der eigentliche Lauf.
run "$module @/dd/qcc_p.bootstrap.c >/dd/diag_full.ir" "Bootstrap-Lauf"
run "dir -e /dd/qcc_diag.txt /dd/diag_full.ir" "Kontrolle"

send "\x1d"
expect eof
