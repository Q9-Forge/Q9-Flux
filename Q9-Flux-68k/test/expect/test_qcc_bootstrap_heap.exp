#!/usr/bin/expect -f
# QCC bootstrap test for the reduced heap-backed action log.
set timeout 600
set send_slow {1 .003}
set image local_images/OS9SYS.qcc-stage1-1m.hda
set mwos /Volumes/SSD1TB/projects/MWOS

spawn ./build/macos/q9.exe --rom $mwos/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/ROMBUG/romimage.dev.running.BIN --cf $image
expect "devices online"
send "\r"
set logged_in 0
for {set i 0} {$i < 10 && !$logged_in} {incr i} {
    expect {
        "User name?:" { send "super\r"; exp_continue }
        -re {Password[^\r\n]*:} { send "Al35uUbC\r"; exp_continue }
        -re {/dd/HOME/ROOT# ?$} { set logged_in 1 }
        timeout { send "\r" }
    }
}
if {!$logged_in} { send_log "\n<<< HEAP LOGIN FAILED >>>\n"; exit 2 }

send -s "/dd/CMDS/q9_qcc_p_bootstrap @/dd/qcc_p.bootstrap.c >/dd/q9_heap.ir\r"
expect {
    -re {PMMU|FAIL|error|Error} { send_log "\n<<< HEAP QCC ERROR >>>\n"; exit 1 }
    -re {/dd/HOME/ROOT# ?$} { send_log "\n<<< HEAP QCC RETURNED >>>\n" }
    timeout { send_log "\n<<< HEAP QCC TIMEOUT >>>\n"; exit 1 }
}
send -s "dir -e /dd/q9_heap.ir\r"
expect {
    -re {\r\n\s+[0-9.]+\s+[^\r\n]*\s+[1-9][0-9]*\s+q9_heap\.ir\s*\r?\n} { send_log "\n<<< HEAP OUTPUT PRESENT >>>\n" }
    -re {\r\n\s+[0-9.]+\s+[^\r\n]*\s+0\s+q9_heap\.ir\s*\r?\n} { send_log "\n<<< HEAP OUTPUT EMPTY >>>\n"; exit 1 }
    -re {error|Error} { send_log "\n<<< HEAP OUTPUT ERROR >>>\n"; exit 1 }
    timeout { send_log "\n<<< HEAP OUTPUT TIMEOUT >>>\n"; exit 1 }
}
send "\x1d"
expect eof
