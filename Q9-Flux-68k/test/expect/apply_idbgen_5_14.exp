#!/usr/bin/expect -f
# 5.14 PRODUKTIV-DEPLOYMENT auf local_images/OS9SYS.hda (Backup existiert:
# OS9SYS.hda.backup-vor-5.14-*). Kompletter, bereits mehrfach auf Testklonen
# verifizierter Workflow:
# 1. Q9-lokale Configs (resolv.conf/routes.conf/interfaces.conf) nach /dd/ETC
# 2. idbgen -> /dd/CMDS/BOOTOBJS/SPF/inetdb + inetdb2 (korrekte 192.168.200.x)
# 3. attr -e -pe auf die frischen Module
# 4. SYS/loadidb (neu), SYS/startup (ruft loadidb VOR netmods auf), SYS/startspf
#    (zurueckgebaut) einspielen
# 5. Sauber beenden, NEU BOOTEN, verifizieren: ifconfig/ping/hostname/netstat

set timeout 90
set send_slow {1 .003}
log_file -noappend test/expect/results/apply_idbgen_5_14_result.txt

set image local_images/OS9SYS.hda
set mwos /Volumes/SSD1TB/projects/MWOS

proc login {} {
    set timeout 60
    expect "devices online"
    set timeout 20
    set logged_in 0
    for {set i 0} {$i < 10 && !$logged_in} {incr i} {
        expect {
            "User name?:" { sleep 2; send -s "super\r"; exp_continue }
            -re {Password[^\r\n]*:} { sleep 2; send -s "Al35uUbC\r"; exp_continue }
            -re {[#$] ?$} { set logged_in 1 }
            timeout { send "\r" }
        }
    }
    if {!$logged_in} { send_log "\n<<<LOGIN FEHLGESCHLAGEN>>>\n"; exit 1 }
}

proc paste_file {localpath remotename blankmarker} {
    send_log "\n<<<TRANSFER $remotename>>>\n"
    sleep 1
    send -s "del $remotename\r"
    expect -re {[#$] ?$}
    sleep 1
    send -s "build $remotename\r"
    expect -re {\? ?$}
    set fp [open $localpath r]
    set raw [read $fp]
    close $fp
    set data ""
    foreach line [split $raw "\n"] {
        if {[string trim $line] eq ""} { append data "$blankmarker\r" } else { append data "$line\r" }
    }
    append data "\r"
    send -s -- $data
    set timeout 60
    expect -re {[#$] ?$}
    set timeout 20
}

spawn ./build/native/q9.exe --rom $mwos/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/ROMBUG/romimage.dev.running.BIN --cf $image
login

send_log "\n=== SCHRITT 1+2: Configs pasten, idbgen laufen lassen ===\n"
sleep 1
send -s "chd /dd/ETC\r"
expect -re {[#$] ?$}
paste_file "$mwos/OS9/68030/PORTS/Q9/SPF/ETC/resolv.conf" "resolv.conf" "#"
paste_file "$mwos/OS9/68030/PORTS/Q9/SPF/ETC/routes.conf" "routes.conf" "#"
paste_file "$mwos/OS9/68030/PORTS/Q9/SPF/ETC/interfaces.conf" "interfaces.conf" "#"

sleep 1
send -s "makdir /dd/CMDS/BOOTOBJS/SPF\r"
expect -re {[#$] ?$}
sleep 1
send -s "chd /dd/CMDS/BOOTOBJS/SPF\r"
expect -re {[#$] ?$}
sleep 1
send -s "idbgen -d=/dd/ETC -d=/dd/MWOS/SRC/ETC inetdb\r"
set timeout 30
expect -re {[#$] ?$}

sleep 1
send -s "dir -e /dd/CMDS/BOOTOBJS/SPF\r"
expect -re {[#$] ?$}

send_log "\n=== SCHRITT 3: attr -e -pe ===\n"
sleep 1
send -s "attr -e -pe /dd/CMDS/BOOTOBJS/SPF/inetdb\r"
expect -re {[#$] ?$}
sleep 1
send -s "attr -e -pe /dd/CMDS/BOOTOBJS/SPF/inetdb2\r"
expect -re {[#$] ?$}

send_log "\n=== SCHRITT 4: SYS/loadidb, SYS/startup, SYS/startspf ===\n"
sleep 1
send -s "chd /dd/SYS\r"
expect -re {[#$] ?$}

paste_file "$mwos/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/BOOTFILES/loadidb" "loadidb" "*"
sleep 1
send -s "attr -e -pe /dd/SYS/loadidb\r"
expect -re {[#$] ?$}

paste_file "$mwos/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/BOOTFILES/startup" "startup" "*"
sleep 1
send -s "attr -e -pe /dd/SYS/startup\r"
expect -re {[#$] ?$}

paste_file "$mwos/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/BOOTFILES/startspf" "startspf" "*"
sleep 1
send -s "attr -e -pe /dd/SYS/startspf\r"
expect -re {[#$] ?$}

send_log "\n<<<HOST-ESCAPE, EMULATOR BEENDEN>>>\n"
send "\x1d"
expect eof

send_log "\n=== SCHRITT 5: NEUSTART UND VERIFIKATION ===\n"
spawn ./build/native/q9.exe --rom $mwos/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/ROMBUG/romimage.dev.running.BIN --cf $image
login

sleep 2
send -s "ifconfig enet0\r"
expect -re {[#$] ?$}
sleep 1
send -s "ping 192.168.200.1\r"
set timeout 30
expect {
    -re {[#$] ?$} {}
    timeout { send_log "\n<<<PING TIMEOUT>>>\n" }
}
sleep 1
send -s "hostname\r"
expect -re {[#$] ?$}
sleep 1
send -s "netstat -i\r"
expect -re {[#$] ?$}
sleep 1
send -s "netstat -r\r"
set timeout 15
expect {
    -re {[#$] ?$} {}
    timeout { send_log "\n<<<netstat -r TIMEOUT (bekannt, DNS-Resolver ohne Netz)>>>\n" }
}

send_log "\n<<<DEPLOYMENT-TEST ENDE>>>\n"
set timeout 10
send "\x1d"
expect eof
