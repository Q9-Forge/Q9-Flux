#!/usr/bin/expect -f
# Small live anchor for QCC's OS-9 large-data function table.
set timeout 90
set send_slow {1 .003}
set image local_images/OS9SYS.qcc-xcc-test.hda
set mwos /Volumes/SSD1TB/projects/MWOS
spawn ./build/macos/q9.exe --rom $mwos/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/ROMBUG/romimage.dev.running.BIN --cf $image
expect "devices online"
send "\r"
set logged_in 0
for {set i 0} {$i < 10 && !$logged_in} {incr i} {
    expect {
        "User name?:" { send "super\r"; exp_continue }
        -re {Password[^\r\n]*:} { send "Al35uUbC\r"; exp_continue }
        -re {[#$] ?$} { set logged_in 1 }
        timeout { send "\r" }
    }
}
send -s "/dd/CMDS/q9_qcc_strchr_call_entry\r"
expect {
    -re {\r\n1\r?\n/dd/HOME/ROOT# ?$} { send_log "\n<<< QCC LARGE-DATA ENTRY OK >>>\n" }
    -re {PMMU|error|Error} { send_log "\n<<< QCC LARGE-DATA ENTRY ERROR >>>\n"; exit 1 }
    timeout { send_log "\n<<< QCC LARGE-DATA ENTRY TIMEOUT >>>\n"; exit 1 }
}
send "\x1d"
expect eof
