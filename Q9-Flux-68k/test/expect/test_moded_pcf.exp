#!/usr/bin/expect -f
# Resolve paths relative to the Q9-Flux-68k project root.
set script_dir [file dirname [file normalize [info script]]]
cd [file normalize "$script_dir/../.."]
# moded-Anleitung: RBF-Descriptor aus partdgen als neue Datei p0 öffnen.
set timeout 240
log_file -noappend test/expect/results/test_moded_pcf.log
spawn ./build/native/q9.exe test/cf/emu_mbr_raw_test.q9
expect "devices online"
sleep 2
send "\r"
expect -re {User name\?:}
send "super\r"
expect -re {Password[^:]*:}
send "Al35uUbC\r"
expect -re {\$ ?$}
send "deiniz d0\r"
expect -re {\$ ?$}
send "unlink -f d0\r"
expect -re {\$ ?$}
send "chd /dd/PROJECTS\r"
expect -re {\$ ?$}
send "attr -e -r d0\r"
expect -re {\$ ?$}
send "load /dd/PROJECTS/d0\r"
expect -re {\$ ?$}
send "save d0 -f=p0\r"
expect -re {\$ ?$}
send "moded d0 -f=/dd/PROJECTS/p0\r"
sleep 2
send "?\r"
sleep 1
send "q\r"
sleep 1
expect -re {\$ ?$}
send "\x1d"
expect eof
