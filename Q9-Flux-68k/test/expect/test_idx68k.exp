#!/usr/bin/expect -f
# Resolve paths relative to the Q9-Flux-68k project root.
set script_dir [file dirname [file normalize [info script]]]
cd [file normalize "$script_dir/../.."]
# Prueft die Struct-Reparatur auf ECHTEM 68k statt nur in der Host-VM.
# Erwartete Ausgabe: 98 3 10 11 98 (Zuweisung, Rueckgabe, Parameter).
log_file -a /tmp/struct68k.log
set timeout 300
set send_slow {1 .003}
set mwos /Volumes/SSD1TB/projects/MWOS
set prompt {[#$] ?$}

spawn ./build/macos/q9.exe --rom $mwos/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/ROMBUG/romimage.dev.running.BIN --cf local_images/OS9SYS.qcc-xcc-test.hda
expect "devices online"
send "\r"
set logged_in 0
for {set i 0} {$i < 10 && !$logged_in} {incr i} {
    expect {
        "User name?:" { send "super\r"; exp_continue }
        -re {Password[^\r\n]*:} { send "Al35uUbC\r"; exp_continue }
        -re $prompt { set logged_in 1 }
        timeout { send "\r" }
    }
}
if {!$logged_in} { send_log "\nST: LOGIN FAILED\n"; exit 1 }

send_log "\nST: --- Struct-Test auf 68k ---\n"
send -s "/dd/CMDS/q9_idxtest\r"
expect {
    -re $prompt          { send_log "\nST: fertig\n" }
    -re {Stack Overflow} { send_log "\nST: STACK OVERFLOW\n"; exit 1 }
    -re {PMMU}           { send_log "\nST: PMMU\n"; exit 1 }
    timeout              { send_log "\nST: TIMEOUT\n"; exit 1 }
}
send "\x1d"
expect eof
