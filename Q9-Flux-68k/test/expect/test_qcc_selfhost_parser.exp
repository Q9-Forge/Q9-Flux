#!/usr/bin/expect -f
# Resolve paths relative to the Q9-Flux-68k project root.
set script_dir [file dirname [file normalize [info script]]]
cd [file normalize "$script_dir/../.."]
# End-to-end bootstrap anchor: q9_qccpselfhost_reloc5 was parsed by the XCC-built
# parser, translated by QCC's own 68k backend, assembled by r68 and linked by
# l68.  It must still parse a small C program on the real Q9 emulator.
set timeout 180
set send_slow {1 .003}
set image local_images/OS9SYS.qcc-xcc-test.hda
set mwos /Volumes/SSD1TB/projects/MWOS
spawn ./build/macos/q9.exe --rom $mwos/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/ROMBUG/romimage.dev.running.BIN --cf $image
expect "devices online"
send "\r"
set logged_in 0
for {set i 0} {$i < 10 && !$logged_in} {incr i} {
    expect {
        "User name?:" { send "super\r"; exp_continue }
        -re {Password[^\r\n]*:} { send "Al35uUbC\r"; exp_continue }
        -re {[#$] ?$} { set logged_in 1 }
        timeout { send "\r" }
    }
}
send -s "/dd/CMDS/q9_qcct3 'int main(){return 0;}'\r"
expect {
    -re {FUNC main} { send_log "\n<<< QCC SELFBuilt PARSER OK >>>\n" }
    -re {FAIL|error|Error} { send_log "\n<<< QCC SELFBuilt PARSER ERROR >>>\n"; exit 1 }
    timeout { send_log "\n<<< QCC SELFBuilt PARSER TIMEOUT >>>\n"; exit 1 }
}
send "\x1d"
expect eof
