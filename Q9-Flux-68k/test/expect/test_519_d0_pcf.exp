#!/usr/bin/expect -f
# Resolve paths relative to the Q9-Flux-68k project root.
set script_dir [file dirname [file normalize [info script]]]
cd [file normalize "$script_dir/../.."]
set timeout 90
spawn ./build/native/q9.exe emu.q9
expect "User name?:"
send "super\r"
expect -re {Password[^:]*:}
send "Al35uUbC\r"
expect -re {\$ ?$}
send "load /dd/CMDS/BOOTOBJS/cfidef\r"
expect -re {\$ ?$}
send "load /dd/CMDS/BOOTOBJS/d0_fmt\r"
expect -re {\$ ?$}
send "iniz d0_fmt\r"
expect -re {\$ ?$}
send "dir -e /d0\r"
expect -re {\$ ?$}
send "\x1d"
expect eof
