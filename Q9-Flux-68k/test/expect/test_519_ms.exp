#!/usr/bin/expect -f
# 5.19a: Master/Slave-Test des RC2014-CF-Interfaces. Master (e0) und Slave (f0) haengen als zwei
# getrennte RBF-Images an demselben Port ($FFFFC010), unterschieden nur durch das DEV-Bit ($E0/$F0).
# Aufruf: expect test_519_ms.exp <config-datei>

set cfg [lindex $argv 0]
set timeout 90
set send_slow {1 .003}
log_file -noappend test/expect/results/test_519_ms_result.txt

spawn ./build/native/q9.exe $cfg
set timeout 60
expect "devices online"
set timeout 20

set logged_in 0
for {set i 0} {$i < 10 && !$logged_in} {incr i} {
    expect {
        "User name?:" { sleep 2; send -s "super\r"; exp_continue }
        -re {Password[^\r\n]*:} { sleep 2; send -s "Al35uUbC\r"; exp_continue }
        -re {\$ ?$} { set logged_in 1 }
        timeout { send "\r" }
    }
}
if {!$logged_in} { send_log "\n<<<LOGIN FEHLGESCHLAGEN>>>\n"; exit 1 }

# PCF-Filemanager fuer das FAT12/16-Image laden. Der f0-Descriptor allein
# haengt nur das Geraet an; ohne pcf kann /f0 nicht initialisiert werden.
sleep 1
send -s "attr -e -pe /dd/CMDS/BOOTOBJS/pcf\r"
expect -re {\$ ?$}
sleep 1
send -s "load /dd/CMDS/BOOTOBJS/pcf\r"
expect -re {\$ ?$}

foreach d {e0 f0} {
    sleep 1
    send -s "attr -e -pe /dd/CMDS/BOOTOBJS/$d\r"
    expect -re {\$ ?$}
    sleep 1
    send -s "load /dd/CMDS/BOOTOBJS/$d\r"
    expect -re {\$ ?$}
}

# Master (e0) zuerst
sleep 1
send -s "iniz /e0\r"
expect -re {\$ ?$}
sleep 1
send -s "dir /e0\r"
expect -re {\$ ?$}

# Slave (f0) — das ist der eigentliche Test
sleep 1
send -s "iniz /f0\r"
expect -re {\$ ?$}
sleep 1
send -s "dir /f0\r"
expect -re {\$ ?$}
sleep 1
send -s "list /f0/SLAVEDAT\r"
expect -re {\$ ?$}

sleep 1
send -s "logout\r"
expect {
    -re {Logout after} { send_log "\n<<<LOGOUT OK>>>\n" }
    timeout { send_log "\n<<<LOGOUT TIMEOUT>>>\n" }
}
send_log "\n<<<TEST ENDE>>>\n"
send "\x1d"
expect eof
