#!/usr/bin/expect -f
# Resolve paths relative to the Q9-Flux-68k project root.
set script_dir [file dirname [file normalize [info script]]]
cd [file normalize "$script_dir/../.."]
# QCC bootstrap against an isolated OS9SYS image with Init M$SysConf=$0010
set timeout 240
set send_slow {1 .003}
set image local_images/OS9SYS.qcc-xcc-noprot-test-v2.hda
set mwos /Volumes/SSD1TB/projects/MWOS

spawn ./build/macos/q9.exe --rom $mwos/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/ROMBUG/romimage.dev.running.BIN --cf $image
expect "devices online"
send "\r"
set logged_in 0
for {set i 0} {$i < 10 && !$logged_in} {incr i} {
    expect {
        "User name?:" { send "super\r"; exp_continue }
        -re {Password[^\r\n]*:} { send "Al35uUbC\r"; exp_continue }
        -re {[#$] ?$} { set logged_in 1 }
        timeout { send "\r" }
    }
}
if {!$logged_in} { send_log "\n<<< NOPROT LOGIN FAILED >>>\n"; exit 2 }

send -s "/dd/CMDS/q9_qcc_p_bootstrap @/dd/qcc_p.bootstrap.c >/dd/q9_noprot.ir\r"
expect {
    -re {[#$] ?$} { send_log "\n<<< NOPROT QCC RETURNED >>>\n" }
    -re {PMMU|FAIL|error|Error} { send_log "\n<<< NOPROT QCC ERROR >>>\n"; exit 1 }
    timeout { send_log "\n<<< NOPROT QCC TIMEOUT >>>\n"; exit 1 }
}
send -s "dir -e /dd/q9_noprot.ir\r"
expect {
    -re {q9_noprot\.ir} { send_log "\n<<< NOPROT OUTPUT PRESENT >>>\n" }
    -re {error|Error} { send_log "\n<<< NOPROT OUTPUT ERROR >>>\n"; exit 1 }
    timeout { send_log "\n<<< NOPROT OUTPUT TIMEOUT >>>\n"; exit 1 }
}
send "\x1d"
expect eof
