#!/usr/bin/expect -f
# Resolve paths relative to the Q9-Flux-68k project root.
set script_dir [file dirname [file normalize [info script]]]
cd [file normalize "$script_dir/../.."]
# Diagnose: Der Parser erzeugt keine IR. Damit wird die grosse stdout-Last vom
# eigentlichen Parser-/Action-Replay getrennt.
set timeout 180
set send_slow {1 .003}
set image local_images/OS9SYS.qcc-xcc-test.hda
set mwos /Volumes/SSD1TB/projects/MWOS
spawn ./build/macos/q9.exe --rom $mwos/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/ROMBUG/romimage.dev.running.BIN --cf $image
expect "devices online"
send "\r"
set logged_in 0
for {set i 0} {$i < 10 && !$logged_in} {incr i} {
    expect {
        "User name?:" { send "super\r"; exp_continue }
        -re {Password[^\r\n]*:} { send "Al35uUbC\r"; exp_continue }
        -re {[#$] ?$} { set logged_in 1 }
        timeout { send "\r" }
    }
}
send -s "/dd/CMDS/q9_qcc_p_xcc_silent @/dd/qcc_p.bootstrap.c >/nil\r"
expect {
    -re {[#$] ?$} { send_log "\n<<< QCC XCC SILENT BOOTSTRAP COMPLETE >>>\n" }
    -re {FAIL|error|Error} { send_log "\n<<< QCC XCC SILENT BOOTSTRAP ERROR >>>\n"; exit 1 }
    timeout { send_log "\n<<< QCC XCC SILENT BOOTSTRAP TIMEOUT >>>\n"; exit 1 }
}
send "\x1d"
expect eof
