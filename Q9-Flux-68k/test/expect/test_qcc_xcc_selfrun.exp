#!/usr/bin/expect -f
# Resolve paths relative to the Q9-Flux-68k project root.
set script_dir [file dirname [file normalize [info script]]]
cd [file normalize "$script_dir/../.."]
set timeout 180
set send_slow {1 .003}
set image local_images/OS9SYS.qcc-xcc-test.hda
set mwos /Volumes/SSD1TB/projects/MWOS
spawn ./build/macos/q9.exe --rom $mwos/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/ROMBUG/romimage.dev.running.BIN --cf $image
expect "devices online"
send "\r"
set logged_in 0
for {set i 0} {$i < 10 && !$logged_in} {incr i} {
    expect {
        "User name?:" { send "super\r"; exp_continue }
        -re {Password[^\r\n]*:} { send "Al35uUbC\r"; exp_continue }
        -re {[#$] ?$} { set logged_in 1 }
        timeout { send "\r" }
    }
}
send -s "/dd/CMDS/q9_qcc_p_xcc_bootstrap @/dd/bootstrap_probe.c\r"
expect {
    -re {FUNC main} { send_log "\n<<< QCC XCC SELF-RUN OK >>>\n" }
    -re {FAIL|error|Error} { send_log "\n<<< QCC XCC SELF-RUN ERROR >>>\n"; exit 1 }
    timeout { send_log "\n<<< QCC XCC SELF-RUN TIMEOUT >>>\n"; exit 1 }
}
# Die Bootstrap-IR geht bewusst direkt in eine Datei. Der XCC-Build benutzt
# QCC_BUFFERED_OUTPUT: ein eigener 8-KB-Writer vermeidet Microware-printf bei
# den vielen kleinen IR-Zeilen.
send -s "/dd/CMDS/q9_qcc_p_xcc_bootstrap @/dd/qcc_p.bootstrap.c >/dd/qcc_p.bootstrap.ir\r"
expect {
    -re {[#$] ?$} { send_log "\n<<< QCC XCC BOOTSTRAP COMPLETE (SEMERR expected) >>>\n" }
    -re {FAIL|error|Error} { send_log "\n<<< QCC XCC BOOTSTRAP PARSE ERROR >>>\n"; exit 1 }
    timeout { send_log "\n<<< QCC XCC BOOTSTRAP TIMEOUT >>>\n"; exit 1 }
}
send "\x1d"
expect eof
