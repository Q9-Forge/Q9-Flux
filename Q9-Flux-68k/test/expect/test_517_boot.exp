#!/usr/bin/expect -f
# Resolve paths relative to the Q9-Flux-68k project root.
set script_dir [file dirname [file normalize [info script]]]
cd [file normalize "$script_dir/../.."]
# 5.17: generischer Boot+Login-Test gegen das Geraete-Registry-Klon-Image, nach jedem einzeln
# umgezogenen Geraet auszufuehren. Prueft: Boot bis "devices online", Login (super/Passwort),
# Datum lesen (RTC), 'dir' (CF), 'echo' (DUART-Konsole ueber THRA/RHRA), sauberes logout.
# Aufruf: expect test_517_boot.exp <rom-pfad> <cf-image> [net_mode]

set rom [lindex $argv 0]
set image [lindex $argv 1]
set net_mode ""
if {[llength $argv] > 2} {
    set net_mode [lindex $argv 2]
}

set timeout 90
set send_slow {1 .003}
log_file -noappend test/expect/results/test_517_result.txt

if {$net_mode eq ""} {
    spawn ./build/native/q9.exe --rom $rom --cf $image
} else {
    spawn ./build/native/q9.exe --rom $rom --cf $image --net $net_mode
}

set timeout 60
expect "devices online"
set timeout 20

set logged_in 0
for {set i 0} {$i < 10 && !$logged_in} {incr i} {
    expect {
        "User name?:" { sleep 2; send -s "super\r"; exp_continue }
        -re {Password[^\r\n]*:} { sleep 2; send -s "Al35uUbC\r"; exp_continue }
        -re {\$ ?$} { set logged_in 1 }
        timeout { send "\r" }
    }
}
if {!$logged_in} { send_log "\n<<<LOGIN FEHLGESCHLAGEN>>>\n"; exit 1 }

sleep 1
send -s "date\r"
expect -re {\$ ?$}

sleep 1
send -s "dir /dd\r"
expect -re {\$ ?$}

sleep 1
send -s "echo hello-5.17\r"
expect -re {\$ ?$}

sleep 1
send -s "logout\r"
expect {
    -re {Logout after} { send_log "\n<<<LOGOUT OK>>>\n" }
    timeout { send_log "\n<<<LOGOUT TIMEOUT>>>\n" }
}

send_log "\n<<<TEST ENDE>>>\n"
send "\x1d"
expect eof
