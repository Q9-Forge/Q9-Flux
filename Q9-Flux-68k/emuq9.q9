; Q9 reales CF-Profil (5.19b) — Standard-Arbeitskonfiguration
; c0: Boot-RBF bei Sektor 0
; d0: separates PCF-Image, Nutzdaten/Descriptor ab Sektor 64
; e0/e1: gemeinsames 2-GB-Image, je 1 GB Partition
; Die Descriptor-Dateien werden vom ROM/Bootfile-Generator verwendet.

[board]
name = Q9SYS Emu
rom  = local_images/roms/romimage.dev.running.BIN
net  = nat
vmnet_ip       = 192.168.201.2
vmnet_gateway  = 192.168.201.1
vmnet_netmask  = 255.255.255.0
vmnet_dhcp_end = 192.168.201.254

[c0]
type = rbf
bus = onboard
unit = master
base = 0xFFFFE000
start_sector = 0
length_sectors = 0x800000
descriptor_lsn = 0
descriptor = yes
descriptorName = local_images/c0
image = local_images/Q9SYS.hda

[d0]
type = pcf
bus = secondary
unit = master
base = 0xFFFFE100
start_sector = 0
length_sectors = 0x3FB800
descriptor_lsn = 64
descriptor = yes
descriptorName = local_images/d0
image = local_images/q9sys-d0-pcf-mbr-test.img

[e0]
type = pcf
bus = secondary
unit = master
base = 0xFFFFE200
start_sector = 0
length_sectors = 0x200000
descriptor_lsn = 64
descriptor = yes
descriptorName = local_images/e0-pcf
image = local_images/q9sys-e-shared-2gb.img

[e1]
type = rbf
bus = secondary
unit = master
base = 0xFFFFE200
start_sector = 0
length_sectors = 0x1FFFC0
descriptor_lsn = 0x200040
descriptor = yes
descriptorName = local_images/e1
image = local_images/q9sys-e-shared-2gb.img
