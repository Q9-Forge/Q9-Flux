#!/usr/bin/expect -f
# pkdvr-Diagnose (2026-07-15, Fortsetzung des Bug-2-RE aus docs/re_telnetdc/OPTION_B_STATUS.md):
# Der Live-Trace (Q9_TRAP_TRACE) zeigte per PC-Rueckrechnung (Wait/Read/SetR-Aufrufstellen minus
# bekannter statischer Offset aus dem rekonstruierten pkdvr-Quelltext) DREI unterschiedliche
# Ladeadressen fuer denselben pkdvr-Code gleichzeitig im Speicher -- Verdacht: der eigentlich
# wiedereintrittsfaehige (ReEnt) Treiber wird mehrfach separat gelinkt/geladen statt geteilt zu
# werden, wodurch Schreiber (pks01/scf) und Leser (pkm01/telnetdc) an getrennten, nicht
# verbundenen Kopien haengen.
#
# Dieses Skript prueft das DIREKT im Gast per "mdir" (Modul-Directory-Kommando) waehrend eines
# aktiven Haengers -- viel einfacher/zuverlaessiger als die PC-Rueckrechnung: mdir listet alle
# residenten Module mit Adresse; kommt "pkdvr" darin mehrfach vor, ist die Mehrfachladung damit
# direkt (ohne Interpretation) bestaetigt.
#
# Login: super / Al35uUbC (s. /dd/SYS/password im Image)

set timeout 90
log_file -noappend test_pkdvr_mdir_check_result.txt

set image local_images/OS9SYS.claudia-optionb-patchtest.hda

spawn sudo -n ./build/native/q9.exe --cb030 /Volumes/SSD1TB/projects/MWOS/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/ROMBUG/romimage.dev.running.BIN --cf $image --net vmnet
set emu_id $spawn_id

set timeout 60
expect -i $emu_id "devices online"
sleep 8

# --- mdir VOR dem Haenger (Referenz: wie oft ist pkdvr schon beim Boot resident?) ---
spawn telnet 192.168.200.2
set tn0_id $spawn_id
set timeout 20
expect -i $tn0_id "User name?:"
send -i $tn0_id "super\r"
expect -i $tn0_id -re {Password[^\r\n]*:}
send -i $tn0_id "Al35uUbC\r"
expect -i $tn0_id -re {\$}
send_log "\n<<<SESSION 0 LOGIN OK>>>\n"
send -i $tn0_id "mdir\r"
expect -i $tn0_id -re {\$\s*$}
send_log "\n<<<MDIR VOR HAENGER (Baseline)>>>\n"
send -i $tn0_id "logout\r"
sleep 2

# --- Session A: loest den Haenger aus ---
spawn telnet 192.168.200.2
set tnA_id $spawn_id
set timeout 20
expect -i $tnA_id "User name?:"
send -i $tnA_id "super\r"
expect -i $tnA_id -re {Password[^\r\n]*:}
send -i $tnA_id "Al35uUbC\r"
expect -i $tnA_id -re {\$}
send_log "\n<<<SESSION A LOGIN OK>>>\n"
send -i $tnA_id "dir -aer /dd\r"
sleep 15

# --- Session B: mdir WAEHREND des aktiven Haengers ---
spawn telnet 192.168.200.2
set tnB_id $spawn_id
set timeout 20
expect -i $tnB_id "User name?:"
send -i $tnB_id "super\r"
expect -i $tnB_id -re {Password[^\r\n]*:}
send -i $tnB_id "Al35uUbC\r"
expect -i $tnB_id -re {\$}
send_log "\n<<<SESSION B LOGIN OK>>>\n"

send -i $tnB_id "mdir\r"
expect -i $tnB_id -re {\$\s*$}
send_log "\n<<<MDIR WAEHREND HAENGER (1)>>>\n"

# Zweite dritte Telnet-Session oeffnen (Session C), OHNE etwas zu tun -- prueft, ob JEDE neue
# Session eine weitere pkdvr-Kopie erzeugt (waere der eigentliche Mechanismus).
spawn telnet 192.168.200.2
set tnC_id $spawn_id
set timeout 20
expect -i $tnC_id "User name?:"
send -i $tnC_id "super\r"
expect -i $tnC_id -re {Password[^\r\n]*:}
send -i $tnC_id "Al35uUbC\r"
expect -i $tnC_id -re {\$}
send_log "\n<<<SESSION C LOGIN OK (neue Session, kein dir)>>>\n"

send -i $tnB_id "mdir\r"
expect -i $tnB_id -re {\$\s*$}
send_log "\n<<<MDIR NACH SESSION C (2) -- neue pkdvr-Kopie durch neue Session?>>>\n"

send -i $tnB_id "logout\r"
sleep 1
send -i $tnC_id "logout\r"
sleep 2

send -i $emu_id "\x1d"
sleep 2
send_log "\n<<<SCRIPT FERTIG>>>\n"
