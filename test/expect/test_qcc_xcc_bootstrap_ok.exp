#!/usr/bin/expect -f
# Bootstrap-Selbstlauf des XCC-gebauten QCC auf dem echten Emulator.
#
# Unterschied zu test_qcc_xcc_selfrun.exp: dort war "SEMERR expected" der
# dokumentierte Sollzustand. Seit dem lextab-Stand vom 2026-08-31 (TC_*-Makros
# statt Funktionen mit TCType-Rueckgabe) uebersetzt QCC seinen eigenen
# generierten Parser am Host fehlerfrei -- dieser Test prueft, ob das auf 68k
# ebenso gilt. Das Schlusswort wird nicht am Terminal geprueft (die IR geht
# bewusst in eine Datei, sonst laufen 2 MB durch die Konsole), sondern
# anschliessend am Host aus der extrahierten Datei.
set timeout 1200
set send_slow {1 .003}
set image local_images/OS9SYS.qcc-xcc-test.hda
set mwos /Volumes/SSD1TB/projects/MWOS
set module /dd/CMDS/q9_qcc_p_xcc_new
set outfile /dd/qcc_p.bootstrap.new.ir

spawn ./build/macos/q9.exe --rom $mwos/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/ROMBUG/romimage.dev.running.BIN --cf $image
expect "devices online"
send "\r"
set logged_in 0
for {set i 0} {$i < 10 && !$logged_in} {incr i} {
    expect {
        "User name?:" { send "super\r"; exp_continue }
        -re {Password[^\r\n]*:} { send "Al35uUbC\r"; exp_continue }
        -re {[#$] ?$} { set logged_in 1 }
        timeout { send "\r" }
    }
}
if {!$logged_in} {
    send_log "\n<<< LOGIN FAILED >>>\n"
    exit 1
}

# Rauchprobe zuerst: ein kleiner Quelltext muss durchlaufen, sonst ist das
# Modul selbst defekt und der grosse Lauf sagt nichts aus.
send -s "$module @/dd/bootstrap_probe.c\r"
expect {
    -re {FUNC main} { send_log "\n<<< SMOKE OK >>>\n" }
    -re {PMMU|FAIL|SEMERR|Stack Overflow|error|Error} { send_log "\n<<< SMOKE FAILED >>>\n"; exit 1 }
    timeout { send_log "\n<<< SMOKE TIMEOUT >>>\n"; exit 1 }
}
expect -re {[#$] ?$}

# Der eigentliche Bootstrap-Lauf: QCC uebersetzt seinen eigenen Quelltext.
send -s "$module @/dd/qcc_p.bootstrap.c >$outfile\r"
expect {
    -re {[#$] ?$}   { send_log "\n<<< BOOTSTRAP RUN COMPLETE >>>\n" }
    -re {PMMU}      { send_log "\n<<< BOOTSTRAP PMMU FAULT >>>\n"; exit 1 }
    -re {Stack Overflow} { send_log "\n<<< BOOTSTRAP STACK OVERFLOW -- Modul mit -olM=1024K bauen >>>\n"; exit 1 }
    -re {error|Error} { send_log "\n<<< BOOTSTRAP ERROR >>>\n"; exit 1 }
    timeout         { send_log "\n<<< BOOTSTRAP TIMEOUT >>>\n"; exit 1 }
}

# Groesse als Grobkontrolle -- das Schlusswort prueft der Host.
send -s "dir -e $outfile\r"
expect -re {[#$] ?$}

send "\x1d"
expect eof
