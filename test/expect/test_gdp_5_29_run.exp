#!/usr/bin/expect -f
# 5.29 GDP-Treiber-Test: Treiber laden + vorgebautes vramtest ausfuehren.

set timeout 90
set send_slow {1 .003}
log_file -noappend test/expect/results/test_gdp_5_29_run_result.txt

set image local_images/OS9SYS.gdp-test-20260803.hda
set mwos /Volumes/SSD1TB/projects/MWOS

proc login {} {
    set timeout 60
    expect "devices online"
    set timeout 20
    set logged_in 0
    for {set i 0} {$i < 10 && !$logged_in} {incr i} {
        expect {
            "User name?:" { sleep 2; send -s "super\r"; exp_continue }
            -re {Password[^\r\n]*:} { sleep 2; send -s "Al35uUbC\r"; exp_continue }
            -re {[#$] ?$} { set logged_in 1 }
            timeout { send "\r" }
        }
    }
    if {!$logged_in} { send_log "\n<<<LOGIN FEHLGESCHLAGEN>>>\n"; exit 1 }
}

spawn ./build/native/q9.exe --cb030 $mwos/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/ROMBUG/romimage.dev.running.BIN --cf $image
login

send_log "\n=== Treiber laden ===\n"
sleep 1
send -s "load /dd/CMDS/BOOTOBJS/mc6845\r"
expect -re {[#$] ?$}
sleep 1
send -s "load /dd/CMDS/BOOTOBJS/crtc0\r"
expect -re {[#$] ?$}

send_log "\n=== Geraet initialisieren (iniz, wie beim Boot fuer dd/x1..x8) ===\n"
sleep 1
send -s "iniz crtc0\r"
expect -re {[#$] ?$}

send_log "\n=== vramtest ausfuehren ===\n"
sleep 1
send -s "/dd/CMDS/GDPTEST/vramtest\r"
set timeout 30
expect -re {[#$] ?$}
set timeout 20

send_log "\n=== Pause fuer host-seitige Video-Bridge-Verifikation (20s) ===\n"
sleep 20

send_log "\n<<<HOST-ESCAPE, EMULATOR BEENDEN>>>\n"
send "\x1d"
expect eof

send_log "\n<<<TEST ENDE>>>\n"
