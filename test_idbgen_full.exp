#!/usr/bin/expect -f
# 5.14 Kompletter End-to-End-Test auf frischem Klon:
# 1. Boot, Login
# 2. Q9-lokale Configs (resolv.conf/routes.conf/interfaces.conf) nach /dd/ETC pasten
#    (Leerzeilen -> "#", "build" bricht sonst vorzeitig ab)
# 3. idbgen -d=/dd/ETC -d=/dd/MWOS/SRC/ETC inetdb  (generische Dateien liegen
#    schon im Image unter /dd/MWOS/SRC/ETC, keine ToolShed-Kopie noetig)
# 4. Neues startspf (mit unlink+attr+load der frischen inetdb/inetdb2 VOR ipstart)
#    nach /dd/SYS/startspf pasten (Leerzeilen -> "*", OS-9-Shell-Kommentarzeichen)
# 5. Emulator sauber beenden, FRISCH NEU BOOTEN (zweiter q9.exe-Prozess)
# 6. OHNE jedes manuelle Netzwerkkommando: ifconfig enet0 pruefen -> muss
#    automatisch 192.168.200.2/16 zeigen

set timeout 90
set send_slow {1 .003}
log_file -noappend idbgen_full_result.txt

set image local_images/OS9SYS.claudia-idbgen-test.hda
set mwos /Volumes/SSD1TB/projects/MWOS

proc paste_file {localpath remotename blankmarker} {
    global send_slow
    send_log "\n<<<TRANSFER $remotename>>>\n"
    sleep 1
    send -s "del $remotename\r"
    expect -re {\$ ?$}
    sleep 1
    send -s "build $remotename\r"
    expect -re {\? ?$}

    set fp [open $localpath r]
    set raw [read $fp]
    close $fp
    set data ""
    foreach line [split $raw "\n"] {
        if {[string trim $line] eq ""} {
            append data "$blankmarker\r"
        } else {
            append data "$line\r"
        }
    }
    append data "\r"
    send -s -- $data
    set timeout 60
    expect -re {\$ ?$}
    set timeout 20
}

spawn ./build/native/q9.exe --cb030 $mwos/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/ROMBUG/romimage.dev.running.BIN --cf $image

set timeout 60
expect "devices online"
set timeout 20

set logged_in 0
for {set i 0} {$i < 10 && !$logged_in} {incr i} {
    expect {
        "User name?:" { sleep 2; send -s "super\r"; exp_continue }
        -re {Password[^\r\n]*:} { sleep 2; send -s "Al35uUbC\r"; exp_continue }
        -re {\$ ?$} { set logged_in 1 }
        timeout { send "\r" }
    }
}
if {!$logged_in} { send_log "\n<<<LOGIN FEHLGESCHLAGEN>>>\n"; exit 1 }

sleep 1
send -s "chd /dd/ETC\r"
expect -re {\$ ?$}

paste_file "$mwos/OS9/68030/PORTS/Q9/SPF/ETC/resolv.conf" "resolv.conf" "#"
paste_file "$mwos/OS9/68030/PORTS/Q9/SPF/ETC/routes.conf" "routes.conf" "#"
paste_file "$mwos/OS9/68030/PORTS/Q9/SPF/ETC/interfaces.conf" "interfaces.conf" "#"

sleep 1
send -s "makdir /dd/CMDS/BOOTOBJS/SPF\r"
expect -re {\$ ?$}
sleep 1
send -s "chd /dd/CMDS/BOOTOBJS/SPF\r"
expect -re {\$ ?$}

send_log "\n<<<IDBGEN LAUF>>>\n"
sleep 1
send -s "idbgen -d=/dd/ETC -d=/dd/MWOS/SRC/ETC inetdb\r"
set timeout 30
expect -re {\$ ?$}

sleep 1
send -s "dir -e /dd/CMDS/BOOTOBJS/SPF\r"
expect -re {\$ ?$}

sleep 1
send -s "chd /dd/SYS\r"
expect -re {\$ ?$}

paste_file "$mwos/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/BOOTFILES/startspf" "startspf" "*"

sleep 1
send -s "attr -e -pe /dd/SYS/startspf\r"
expect -re {\$ ?$}

send_log "\n<<<HOST-ESCAPE, EMULATOR BEENDEN>>>\n"
send "\x1d"
expect eof

# --- Frischer Boot, KEINE manuellen Netzwerkbefehle ---
send_log "\n<<<NEUER BOOT-VORGANG>>>\n"

spawn ./build/native/q9.exe --cb030 $mwos/OS9/68030/PORTS/Q9/CMDS/BOOTOBJS/ROMBUG/romimage.dev.running.BIN --cf $image

set timeout 60
expect "devices online"
set timeout 20

set logged_in 0
for {set i 0} {$i < 10 && !$logged_in} {incr i} {
    expect {
        "User name?:" { sleep 2; send -s "super\r"; exp_continue }
        -re {Password[^\r\n]*:} { sleep 2; send -s "Al35uUbC\r"; exp_continue }
        -re {\$ ?$} { set logged_in 1 }
        timeout { send "\r" }
    }
}
if {!$logged_in} { send_log "\n<<<LOGIN FEHLGESCHLAGEN (2. Boot)>>>\n"; exit 1 }

sleep 2
send -s "ifconfig enet0\r"
expect -re {\$ ?$}

sleep 1
send -s "ping 192.168.200.1\r"
set timeout 30
expect {
    -re {\$ ?$} {}
    timeout { send_log "\n<<<PING TIMEOUT>>>\n" }
}

send_log "\n<<<TEST ENDE>>>\n"
send "\x1d"
expect eof
